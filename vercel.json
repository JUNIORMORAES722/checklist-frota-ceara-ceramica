{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/gestores/(.*)",
      "dest": "https://frota-ceara-backend.onrender.com/gestores/$1"
    },
    {
      "src": "/motoristas/(.*)",
      "dest": "https://frota-ceara-backend.onrender.com/motoristas/$1"
    },
    {
      "src": "/veiculos/(.*)",
      "dest": "https://frota-ceara-backend.onrender.com/veiculos/$1"
    },
    {
      "src": "/checklists/(.*)",
      "dest": "https://frota-ceara-backend.onrender.com/checklists/$1"
    },
    {
      "src": "/pendencias/(.*)",
      "dest": "https://frota-ceara-backend.onrender.com/pendencias/$1"
    },
    {
      "src": "/eu",
      "dest": "https://frota-ceara-backend.onrender.com/eu"
    },
    {
      "src": "/health",
      "dest": "https://frota-ceara-backend.onrender.com/health"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
