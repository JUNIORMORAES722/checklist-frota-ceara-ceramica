# Copie este arquivo para .env.
# Não publique o .env e não coloque senhas de usuários aqui.
#
# Gere o segredo no PowerShell:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=
SQLITE_PATH=data/frota.sqlite
FOTOS_PATH=data/fotos
BACKUP_DIR=backups
BACKUP_RETENCAO_DIAS=14
JSON_PATH=db.json

# Origens extras, separadas por vírgula, somente se o navegador acessar a API de outro endereço.
# O mesmo endereço da página, inclusive na rede local, não precisa desta variável.
# CORS_ORIGENS=https://frota.exemplo.interno
