# Copie este arquivo para .env no desenvolvimento local.
# Não publique o .env e não coloque senhas de usuários aqui.
#
# Gere o segredo no PowerShell:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

JWT_SECRET=

# Produção no Neon / PostgreSQL. Se DATABASE_URL tiver valor, o servidor usa PostgreSQL.
# No Render, cadastre essa variável nas Environment Variables do Web Service.
# DATABASE_URL=

SQLITE_PATH=data/frota.sqlite
FOTOS_PATH=data/fotos
BACKUP_DIR=backups
BACKUP_RETENCAO_DIAS=14
JSON_PATH=db.json

# Origens permitidas para CORS (obrigatório quando o frontend está na Vercel e o backend no Render).
# Separe por vírgulas. Suporta domínios exatos e curingas (*.vercel.app ou *):
# CORS_ORIGENS=https://frota-ceara-ceramica.vercel.app,*.vercel.app
